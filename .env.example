
# ==========================================
# AUTO SHOP PRO - BACKEND ENVIRONMENT
# ==========================================

# 1. SUPABASE PROJECT
SUPABASE_URL=https://xbaxkjdqvwligbbsltvb.supabase.co

# Supabase Anon / Publishable Key
SUPABASE_ANON_KEY=sb_publishable_AU3vz0018_tOt9XT9QE3wg_o4r_-rmf

# Supabase Service Role Key
# ใช้เฉพาะใน Render Environment Variables
# ห้ามนำ Service Role Key จริงใส่ GitHub
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ==========================================
# 2. JWT SECURITY
# ==========================================

# ต้องมีความยาวอย่างน้อย 32 ตัวอักษร
# เปลี่ยนเป็นค่าสุ่มที่คาดเดาไม่ได้ก่อนใช้งานจริง
JWT_SECRET=CHANGE_TO_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ==========================================
# 3. CORS SECURITY
# ==========================================

# ใส่ Origin ของ GitHub Pages
# ตัวอย่าง https://ชื่อผู้ใช้.github.io
CORS_ORIGINS=https://YOUR_GITHUB_NAME.github.io

# ==========================================
# 4. SERVER CONFIGURATION
# ==========================================

PORT=3000
NODE_ENV=production

# ==========================================
# 5. LICENSE CONFIGURATION
# ==========================================

TRIAL_DAYS=14
SETUP_TOKEN_MINUTES=20
